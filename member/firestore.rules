rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // HELPERS
    // =========================
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    // Required: uid, name, phone, town.
    // Optional (type-checked only if present): email, photoURL, status,
    // joinedAt, showInList. Extra fields are tolerated.
    function validMember(d) {
      return d.uid == request.auth.uid
        && d.name is string  && d.name.size() > 0  && d.name.size() <= 80
        && d.phone is string && d.phone.size() > 0 && d.phone.size() <= 20
        && d.town is string  && d.town.size() > 0  && d.town.size() <= 80
        && (!('email' in d)      || d.email is string)
        && (!('photoURL' in d)   || d.photoURL is string)
        && (!('status' in d)     || d.status is string)
        && (!('joinedAt' in d)   || d.joinedAt is timestamp)
        && (!('showInList' in d) || d.showInList is bool);
    }

    // =========================
    // MEMBERS (private)
    // =========================
    match /members/{userId} {

      // User can read only their own member record.
      allow read: if signedIn() && request.auth.uid == userId;

      // Document ID and stored uid must both be the logged-in UID.
      allow create: if signedIn()
                    && request.auth.uid == userId
                    && validMember(request.resource.data);

      // The doc ID already pins ownership, so only the NEW uid is checked.
      // (Checking resource.data.uid too would block repairing legacy
      // documents that have no uid field.)
      allow update: if signedIn()
                    && request.auth.uid == userId
                    && validMember(request.resource.data);

      allow delete: if signedIn() && request.auth.uid == userId;
    }

    // =========================
    // PUBLIC MEMBER DIRECTORY
    // =========================
    match /directory/{userId} {
      allow read: if true;

      // Signed-in users manage only their own directory entry.
      allow create, update: if signedIn()
                            && request.auth.uid == userId
                            && request.resource.data.name is string
                            && request.resource.data.name.size() > 0
                            && request.resource.data.name.size() <= 80;

      allow delete: if signedIn() && request.auth.uid == userId;
    }

    // =========================
    // SERVICE REQUESTS
    // =========================
    match /requests/{requestId} {

      allow create: if isMember()
                    && request.resource.data.keys().hasOnly(
                         ['uid', 'name', 'phone', 'type', 'note', 'status', 'createdAt'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 80
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() <= 20
                    && request.resource.data.type is string
                    && request.resource.data.type.size() > 0
                    && request.resource.data.type.size() <= 100
                    && request.resource.data.note is string
                    && request.resource.data.note.size() <= 1000
                    && request.resource.data.status == 'new'
                    && request.resource.data.createdAt == request.time;

      // Owner can read their own requests.
      allow read: if signedIn() && resource.data.uid == request.auth.uid;

      // Admins can read and delete any request.
      allow read, delete: if isAdmin();

      // Admins may change ONLY the status field.
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                    && request.resource.data.status in ['new', 'progress', 'done'];
    }

    // =========================
    // ANNOUNCEMENTS
    // =========================
    match /announcements/{announcementId} {

      // Members (and admins) only.
      allow read: if isMember() || isAdmin();

      allow create, update: if isAdmin()
                            && request.resource.data.keys().hasOnly(['title', 'body', 'createdAt'])
                            && request.resource.data.title is string
                            && request.resource.data.title.size() > 0
                            && request.resource.data.title.size() <= 120
                            && request.resource.data.body is string
                            && request.resource.data.body.size() > 0
                            && request.resource.data.body.size() <= 2000
                            && request.resource.data.createdAt is timestamp;

      allow delete: if isAdmin();
    }

    // =========================
    // ADMINS (managed from the Firebase Console only)
    // =========================
    match /admins/{adminId} {
      allow read: if signedIn() && request.auth.uid == adminId;
      allow create, update, delete: if false;
    }
  }
}
